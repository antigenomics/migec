// Per-process config for the MIGEC module. `includeConfig` this from your pipeline's config,
// mirroring how the other tool modules are wired.

params {
    // ── THE BARCODE LAYOUT. There is no default that is right for two chemistries, so this has
    //    no default at all: set it, or set `bc_pattern` per sample in the meta map.
    //      N   a UMI position, captured, never scored
    //      X   a cell barcode position, captured separately
    //      ACGT / IUPAC   scored exactly;  lowercase   scored at half weight (the adapter)
    //      .   wildcard, neither scored nor captured
    //
    //    10x 5' v2   'XXXXXXXXXXXXXXXXNNNNNNNNNN'   with migec_max_offset = 0
    //    MIGEC       'aaACTcagtggtatcaacgcagagtNNNNtNNNNtNNNN'
    //    HIV PrimerID 'NNNNNNNNNcagtttaacttttgggccatcca'
    //
    // ⚠ umi_tools spells a cell barcode `C`. Here `C` is cytosine -- migec refuses a pattern with
    //   a run of literal C rather than compiling one that matches nothing.
    migec_bc_pattern = null

    // ── WHERE THE PATTERN MAY START. -1 scans the whole read; 0 anchors it at the first base.
    // ⛔ A positional chemistry needs 0 and cannot work without it: 10x has no constant sequence
    //    to anchor on at all, and a five-base dual-end handle carries 10 bits against a free
    //    scan's 12.6-bit bar. A free scan refusing those is correct, not a bug.
    migec_max_offset = -1

    // ── WHICH MATE CARRIES THE PAYLOAD (1 or 2), for `refine` and `assemble`.
    // ⛔ On 10x it is 2: the barcode read is 26 nt of cell barcode and UMI and nothing else, so
    //    running the later stages on R1 gives empty consensuses -- and migec reports a payload
    //    clonality of 1.0 saying exactly that, which is easy to miss in a pipeline log.
    migec_payload_mate = 1

    // Cells expected, for the OrdMag call. Ignored without cell barcodes. EmptyDrops-style rescue
    // of low-count cells is Cell Ranger's job and is deliberately not reproduced.
    migec_expect_cells = 3000

    // The list of cell barcodes that were actually synthesised (10x ships one). Without it, an
    // observed barcode one substitution off a real one stays its own molecule.
    migec_cell_whitelist = null

    // The RT/first-cycle-PCR error floor, which caps every emitted quality at -10 log10 of it.
    // ⛔ Measured at 1.5e-4 on an HIV-1 Primer ID control, so ~Q38. The 1e-6 that gets assumed is
    //    excluded by two orders of magnitude; raising this claims a quality no chemistry supports.
    migec_rt_error = 1e-4

    // Free-form extras, appended last to each stage. Do NOT put --threads or the pattern here:
    // the module owns those.
    migec_checkout_args = ''
    migec_refine_args   = ''
    migec_assemble_args = ''
}

process {
    // ⛔ Every MIGEC setting lives INSIDE `withName:`. Never lift `conda`, `container` or `ext`
    // to bare `process { }` scope -- there they apply to EVERY process in the pipeline.
    withName: 'MIGEC' {
        // conda = "${projectDir}/modules/local/migec/environment.yml"

        // A pipeline that never set a pattern cannot be given a guess: the layout is a property
        // of the library prep, and running the wrong one produces barcodes rather than an error.
        // `migec suggest` reads the layout off the reads if it is genuinely unknown.
        ext.when = { params.migec_bc_pattern != null || (meta?.bc_pattern != null) }

        publishDir = [
            path: { "${params.outdir}/migec" },
            mode: params.getOrDefault('publish_dir_mode', 'copy'),
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
