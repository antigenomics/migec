// Defaults for the migec modules. `includeConfig` this, or set the same keys in your own config.
// Every module reads them with getOrDefault, so not including this file is not an error -- the
// defaults below are then the ones written in the modules themselves.

params {
    // Where the barcode is. Exactly one of these, or per-sample keys in `meta`.
    migec_bc_pattern      = null    // '^NNNNNNNN', '0:8', 'cell:0:16,16:26'
    migec_preset          = null    // umi | migec | primerid | duplex | 10x | 10x-v2 | tso500 | smarter-umi
    migec_read_structure  = null    // fgbio, e.g. '5M5S+T'
    migec_read_structure2 = null
    migec_barcodes        = null    // a MIGEC barcode table, for many samples in one file
    migec_max_offset      = null    // leave null: the anchor is automatic

    // Which mate carries sequence after checkout. 2 for 10x, where R1 is barcode and nothing else.
    migec_payload_mate    = 1

    migec_expect_cells    = 3000
    migec_cell_whitelist  = null
    // The pre-amplification error floor, by chemistry: rt (1e-4, Q40) | medium (1e-5) | high (1e-6)
    // -- or a rate. It is the one-molecule floor; see the assemble module.
    migec_rt_error        = 'rt'
    migec_contig          = false   // random-primed reads that tile the molecule
    migec_fast            = false   // counting mode: modal sequence, no error correction

    // Smoke tests on a big run. Never a sample -- see `migec subsample` for that.
    migec_limit_read      = 0
    migec_limit_umi       = 0

    migec_plots           = true
    migec_plot_format     = 'svg'

    // Escape hatches, appended verbatim.
    migec_checkout_args   = ''
    migec_refine_args     = ''
    migec_assemble_args   = ''
}

process {
    // checkout scales with READS and threads well; refine is bounded by DISTINCT BARCODES and
    // wants memory more than cores; assemble is bounded by one bucket per worker. All three are
    // byte-identical at any thread count, so retrying with different cpus is safe.
    withName: 'MIGEC_CHECKOUT' {
        publishDir = [ path: { "${params.outdir}/migec/${meta.id}/checkout" }, mode: 'copy',
                       pattern: '*.tsv' ]
    }
    withName: 'MIGEC_REFINE' {
        publishDir = [ path: { "${params.outdir}/migec/${meta.id}/refine" }, mode: 'copy',
                       pattern: '*.{tsv,json}' ]
    }
    withName: 'MIGEC_ASSEMBLE' {
        publishDir = [ path: { "${params.outdir}/migec/${meta.id}" }, mode: 'copy',
                       pattern: '*.{fq.gz,tsv,json}' ]
    }
    withName: 'MIGEC_PLOT' {
        publishDir = [ path: { "${params.outdir}/migec/${meta.id}/plots" }, mode: 'copy' ]
    }
}
